    <string notr="true">
/* ===== MAIN WINDOW ===== */

QMainWindow,
QDialog {
    background-color: #FFF0F3;
    color: #704653;
    font-family: &quot;Inter&quot;;
    font-size: 10pt;
}

QWidget {
    font-family: &quot;Inter&quot;;
}

/* ===== MAIN CONTENT ===== */

QWidget#centralwidget {
    background-color: #FFF0F3;
}

/* ===== HEADINGS ===== */

QLabel {
    color: #704653;
    background-color: transparent;
    border: none;
}

QLabel#lblTitle {
    color: #C45B7A;
    font-size: 25pt;
    font-weight: bold;
}

QLabel#lblSubtitle {
    color: #A77987;
    font-size: 11pt;
}

/* ===== MODULE BUTTONS ===== */

QPushButton {
    background-color: #FFDCE6;
    color: #87475D;
    border: 2px solid #F3B5C8;
    border-radius: 14px;
    padding: 14px;
    min-height: 48px;
    font-size: 11pt;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #FFC4D6;
    border: 2px solid #E994B1;
    color: #78364D;
}

QPushButton:pressed {
    background-color: #F2A9C0;
    border: 2px solid #DF87A6;
    padding-top: 16px;
}

/* ===== INPUT FIELDS ===== */

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QTextEdit,
QPlainTextEdit {
    background-color: #FFFAFC;
    color: #704653;
    border: 1px solid #EABAC9;
    border-radius: 8px;
    padding: 7px;
    selection-background-color: #ECA3BB;
}

/* ===== TABLES ===== */

QTableWidget,
QTableView {
    background-color: #FFFAFC;
    alternate-background-color: #FFF0F4;
    color: #704653;
    gridline-color: #F0C6D3;
    border: 1px solid #EABAC9;
    border-radius: 8px;
}

QHeaderView::section {
    background-color: #F8D4E0;
    color: #784254;
    padding: 8px;
    border: none;
    font-weight: bold;
}
</string>
